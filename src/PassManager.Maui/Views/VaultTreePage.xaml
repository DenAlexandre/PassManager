<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PassManager.Maui.ViewModels"
             x:Class="PassManager.Maui.Views.VaultTreePage"
             x:Name="RootPage"
             x:DataType="vm:VaultTreeViewModel"
             Title="Mon coffre">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="20,14"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label Grid.Column="0" Text="PassManager" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,0,12,0" />
            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                <Button Text="Synchroniser" Command="{Binding SyncCommand}" />
                <Button Text="Déconnexion" Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Gray500}" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="20,8" RowSpacing="0" IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Success}" Style="{StaticResource CaptionLabel}" />
        </Grid>
        <Grid Grid.Row="1" Padding="20,8" RowSpacing="0" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" Style="{StaticResource CaptionLabel}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="280,1,*" Padding="0">

            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="0">
                <Label Grid.Row="0" Text="Dossiers" Style="{StaticResource SectionHeaderLabel}" Padding="20,16" />

                <CollectionView Grid.Row="1" ItemsSource="{Binding Folders}"
                                SelectionMode="Single" SelectedItem="{Binding SelectedFolder}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <Grid Padding="8,10" ColumnDefinitions="Auto,24,*,Auto">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <BoxView Grid.Column="0" WidthRequest="{Binding IndentWidth}" Color="Transparent" />
                                <Button Grid.Column="1" Text="{Binding IsExpanded, Converter={StaticResource ExpandedToChevronConverter}}"
                                        WidthRequest="24" MinimumWidthRequest="24" MinimumHeightRequest="24"
                                        Padding="0" FontSize="12" TextColor="{StaticResource Gray500}" BackgroundColor="Transparent"
                                        IsVisible="{Binding HasChildren}"
                                        Command="{Binding BindingContext.ToggleExpandCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                <Label Grid.Column="2" Text="{Binding Name, StringFormat='📁 {0}'}" VerticalOptions="Center" />
                                <Button Grid.Column="3" Text="⋯" WidthRequest="32" MinimumWidthRequest="32" MinimumHeightRequest="32"
                                        Padding="0" TextColor="{StaticResource Gray500}" BackgroundColor="Transparent"
                                        IsVisible="{Binding IsRoot, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding BindingContext.FolderOptionsCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="2" Text="+ Nouveau dossier" Command="{Binding NewFolderCommand}"
                        Margin="12" BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        HorizontalOptions="Start" />
            </Grid>

            <BoxView Grid.Column="1" WidthRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*" Padding="0">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16">
                    <Label Grid.Column="0" Text="Entrées" Style="{StaticResource SectionHeaderLabel}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="+ Nouvelle entrée" Command="{Binding NewEntryCommand}" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryRowViewModel">
                            <Grid Padding="20,12" ColumnDefinitions="*,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="1" Text="{Binding Login}" TextColor="{StaticResource Gray500}" HorizontalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
