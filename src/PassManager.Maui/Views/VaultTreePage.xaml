<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PassManager.Maui.ViewModels"
             x:Class="PassManager.Maui.Views.VaultTreePage"
             x:Name="RootPage"
             x:DataType="vm:VaultTreeViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Padding="20,14"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Button Grid.Column="0" Text="☰" WidthRequest="44" Command="{Binding ToggleMenuCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Gray500}" Margin="0,0,8,0" />
            <Label Grid.Column="1" Text="PassManager" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,0,12,0" />
            <HorizontalStackLayout Grid.Column="3" Spacing="8">
                <Button Text="Synchroniser" Command="{Binding SyncCommand}" />
                <Button Text="Déconnexion" Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Gray500}" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="20,8" RowSpacing="0" IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Success}" Style="{StaticResource CaptionLabel}" />
        </Grid>
        <Grid Grid.Row="1" Padding="20,8" RowSpacing="0" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}">
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" Style="{StaticResource CaptionLabel}" />
        </Grid>

        <Grid Grid.Row="2" x:Name="ContentGrid" ColumnDefinitions="280,8,*" Padding="0">
            <Grid.GestureRecognizers>
                <PointerGestureRecognizer PointerMoved="OnContentGridPointerMoved" PointerReleased="OnSplitterPointerReleased" />
            </Grid.GestureRecognizers>

            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="0">
                <Label Grid.Row="0" Text="Dossiers" Style="{StaticResource SectionHeaderLabel}" FontSize="12" Padding="12,6" />

                <CollectionView Grid.Row="1" ItemsSource="{Binding Folders}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <Grid Padding="4,2" ColumnDefinitions="Auto,18,*,Auto" BackgroundColor="Transparent">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectFolderCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                    <DragGestureRecognizer CanDrag="True"
                                        DragStartingCommand="{Binding BindingContext.FolderDragStartingCommand, Source={x:Reference RootPage}}"
                                        DragStartingCommandParameter="{Binding .}" />
                                    <DropGestureRecognizer AllowDrop="True"
                                        DropCommand="{Binding BindingContext.FolderDropCommand, Source={x:Reference RootPage}}"
                                        DropCommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <BoxView Grid.Column="0" WidthRequest="{Binding IndentWidth}" Color="Transparent" />
                                <Button Grid.Column="1" Text="{Binding IsExpanded, Converter={StaticResource ExpandedToChevronConverter}}"
                                        WidthRequest="18" MinimumWidthRequest="18" MinimumHeightRequest="18"
                                        Padding="0" FontSize="10" TextColor="{StaticResource Gray500}" BackgroundColor="Transparent"
                                        IsVisible="{Binding HasChildren}"
                                        Command="{Binding BindingContext.ToggleExpandCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                <Label Grid.Column="2" Text="{Binding Name, StringFormat='📁 {0}'}" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Button Grid.Column="3" Text="⋯" WidthRequest="22" MinimumWidthRequest="22" MinimumHeightRequest="22"
                                        Padding="0" FontSize="12" TextColor="{StaticResource Gray500}" BackgroundColor="Transparent"
                                        IsVisible="{Binding IsRoot, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding BindingContext.FolderOptionsCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="2" Text="+ Nouveau dossier" Command="{Binding NewFolderCommand}"
                        FontSize="12" Padding="8,4" Margin="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        HorizontalOptions="Start" />
            </Grid>

            <Grid Grid.Column="1" x:Name="SplitterHandle" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnSplitterPointerPressed" PointerReleased="OnSplitterPointerReleased" />
                </Grid.GestureRecognizers>
                <BoxView WidthRequest="1" HorizontalOptions="Center" VerticalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" Padding="0">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,6">
                    <Label Grid.Column="0" Text="Entrées" Style="{StaticResource SectionHeaderLabel}" FontSize="12" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="+ Nouvelle entrée" FontSize="12" Padding="8,4" Command="{Binding NewEntryCommand}" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryRowViewModel">
                            <Grid Padding="12,4" ColumnDefinitions="*,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenEntryCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="12" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding Login}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" LineBreakMode="TailTruncation" />
                                <Button Grid.Column="2" Text="⋯" WidthRequest="22" MinimumWidthRequest="22" MinimumHeightRequest="22"
                                        Padding="0" FontSize="12" TextColor="{StaticResource Gray500}" BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.EntryOptionsCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsMenuOpen}" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsMenuOpen}"
                HorizontalOptions="Start" VerticalOptions="Start" Margin="20,58,0,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 8" Padding="0">
            <VerticalStackLayout WidthRequest="200" Spacing="0">
                <Grid Padding="16,12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Importer (.kdbx)" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
                </Grid>
                <Grid Padding="16,12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExportCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="Exporter (.kdbx)" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
